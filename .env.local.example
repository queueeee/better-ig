# Kopiere diese Datei nach .env.local und trag deine Projektwerte ein.
# Zu finden im Supabase-Dashboard unter Project Settings → API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Beide Werte sind öffentlich und landen im Browser-Bundle — das ist so
# vorgesehen. Der Secret Key (sb_secret_...) gehört NICHT hierher: er umgeht
# Row Level Security und darf den Server nie verlassen.

# Adresse für den Testversand: npm run check -- --mail
# Ohne verifizierte Domain in Resend muss das die Adresse sein, mit der
# das Resend-Konto angelegt wurde — jede andere wird abgelehnt.
CHECK_TEST_EMAIL=du@example.com
